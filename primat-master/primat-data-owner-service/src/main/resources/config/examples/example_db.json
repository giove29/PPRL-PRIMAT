{
  "_comment": "Esempio di sorgente dati DB (Postgres), letta da JdbcRecordSource via 'SELECT * FROM tableName'. Richiede una tabella 'party_a_records' le cui colonne siano nello stesso ordine posizionale dichiarato da 'columns[].index' qui sotto (stesso contratto posizionale gia' usato per il CSV, qui e' l'ordine di definizione della tabella invece dell'ordine delle colonne nel file).",
  "party": "A",
  "debug": true,
  "mqttBrokerUrl": "tcp://localhost:1883",
  "dataSource": {
    "type": "DB",
    "db": {
      "tableName": "party_a_records",
      "jdbcUrl": "jdbc:postgresql://localhost:5432/primat",
      "username": "primat",
      "password": "primat"
    }
  },
  "bloomFilter": {
    "length": 1024,
    "hardening": {
      "type": "XOR_FOLD",
      "foldCount": 1
    }
  },
  "missingValueHandling": {
    "enabled": true,
    "anchorPriority": ["LN", "FN", "YOB", "BIRTH_PLACE", "CITY", "MN"]
  },
  "columns": [
    { "index": 0, "name": "PARTY", "role": "PARTY" },
    { "index": 1, "name": "GLOBAL_ID", "role": "GLOBAL_ID" },
    { "index": 2, "name": "ID", "role": "ID" },
    { "index": 3, "name": "FN", "role": "QID", "dataType": "TEXT", "hashFunctions": 24, "salt": "FN_",
      "constantWeightEncoding": { "enabled": true, "minTrigrams": 4, "maxTrigrams": 12 } },
    { "index": 4, "name": "MN", "role": "QID", "dataType": "TEXT", "hashFunctions": 6, "salt": "MN_",
      "constantWeightEncoding": { "enabled": true, "minTrigrams": 2, "maxTrigrams": 8 } },
    { "index": 5, "name": "LN", "role": "QID", "dataType": "TEXT", "hashFunctions": 25, "salt": "LN_",
      "constantWeightEncoding": { "enabled": true, "minTrigrams": 4, "maxTrigrams": 14 } },
    { "index": 6, "name": "YOB", "role": "QID", "dataType": "NUMERIC", "hashFunctions": 25, "salt": "YOB_",
      "constantWeightEncoding": { "enabled": true, "minTrigrams": 5, "maxTrigrams": 7 } },
    { "index": 7, "name": "BIRTH_PLACE", "role": "QID", "dataType": "TEXT", "hashFunctions": 6, "salt": "BIRTHPLACE_",
      "constantWeightEncoding": { "enabled": true, "minTrigrams": 3, "maxTrigrams": 12 } },
    { "index": 9, "name": "CITY", "role": "QID", "dataType": "TEXT", "hashFunctions": 4, "salt": "CITY_",
      "constantWeightEncoding": { "enabled": true, "minTrigrams": 3, "maxTrigrams": 10 } }
  ]
}
