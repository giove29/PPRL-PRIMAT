{
  "mqttBrokerUrl": "tcp://localhost:1883",
  "debug": true,
  "parties": [
    { "name": "A", "duplicateFree": false },
    { "name": "B", "duplicateFree": false }
  ],
  "clusteringMethod": "CENTER_CLUSTERING",
  "similarityThreshold": "range",
  "range": {
    "from": 0.6,
    "to": 0.95,
    "step": 0.05
  },
  "rbfSize": 1024,
  "blocking": {
    "jaccardLsh": {
      "keySize": 8,
      "keys": 20
    }
  },
  "persistence": {
    "enabled": false,
    "csvOutputPath": "center_clustering_debug_output.csv"
  }
}
