{
  "mqttBrokerUrl": "tcp://localhost:1883",
  "debug": true,
  "parties": [
    { "name": "org", "duplicateFree": true },
    { "name": "org1", "duplicateFree": true }
  ],
  "clusteringMethod": "CLIP",
  "similarityThreshold": 0.75,
  "_range": { "from": 0.6, "to": 0.95, "step": 0.05 },
  "rbfSize": 1024,
  "blocking": {
    "jaccardLsh": {
      "keySize": 8,
      "keys": 20
    }
  },
  "persistence": {
    "enabled": false,
    "csvOutputPath": "clip_debug_output.csv"
  }
}