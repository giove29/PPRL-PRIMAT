{
  "mqttBrokerUrl": "tcp://localhost:1883",
  "debug": true,
  "parties": [
    { "name": "org", "duplicateFree": true },
    { "name": "org1", "duplicateFree": false }
  ],
  "clusteringMethod": "MSCD_AP",
  "similarityThreshold": "range",
  "range": { "from": 0.55, "to": 0.95, "step": 0.05 },
  "rbfSize": 1024,
  "blocking": {
    "jaccardLsh": {
      "keySize": 6,
      "keys": 20,
      "valueRange": 1024
    }
  },
  "persistence": {
    "enabled": false,
    "csvOutputPath": "mscdap_debug_output.csv"
  }
}