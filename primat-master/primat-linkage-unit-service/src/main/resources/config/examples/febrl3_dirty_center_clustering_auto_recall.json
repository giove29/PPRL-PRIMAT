{
  "mqttBrokerUrl": "tcp://localhost:1883",
  "debug": true,
  "parties": [
    { "name": "org", "duplicateFree": false }
  ],
  "clusteringMethod": "CENTER_CLUSTERING",
  "similarityThreshold": "auto_recall",
  "autoThreshold": { "epsilon": 0.05 },
  "rbfSize": 1024,
  "blocking": {
    "jaccardLsh": {
      "keySize": 8,
      "keys": 20
    }
  },
  "persistence": {
    "enabled": false,
    "csvOutputPath": "center_clustering_debug_output.csv"
  }
}